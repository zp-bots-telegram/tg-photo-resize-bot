# Copy this file to `.env` and fill in your values.
# Used by docker-compose.local-api.yml.

# From @BotFather in Telegram.
TG_BOT_KEY=

# From https://my.telegram.org → "API development tools".
# Required by the self-hosted telegram-bot-api server, NOT by the bot itself.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
